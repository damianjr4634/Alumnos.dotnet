@using Esba.Application.DTOs.Academica
@using Esba.Application.Features.Academica
@using Esba.Web.Seguridad
@using Microsoft.AspNetCore.Components.Authorization
@inject ConfirmarRegularizacionHandler Confirmar
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Grilla editable de regularización, compartida por las variantes por-alumno y
   por-comisión. Solo markup, binding y estado de presentación; la condición la
   calcula el dominio (vía el handler) y el volcado el servidor (§2.1). *@

<MudPaper Outlined="true" Class="pa-2">
    <MudTable T="FilaVm" Items="_filas" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent>
            <MudTh Class="d-none d-md-table-cell">Alumno</MudTh>
            <MudTh>Materia</MudTh>
            <MudTh>Condición</MudTh>
            <MudTh>1° Parc.</MudTh>
            <MudTh>2° Parc.</MudTh>
            <MudTh>Recup.</MudTh>
            <MudTh Class="d-none d-lg-table-cell">Hs.</MudTh>
            <MudTh Class="d-none d-lg-table-cell">Inasist.</MudTh>
            <MudTh Class="d-none d-lg-table-cell">Justif.</MudTh>
            <MudTh>Resultante</MudTh>
            @if (PermiteLibre)
            {
                <MudTh aria-label="Acciones"></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Alumno" Class="d-none d-md-table-cell">@context.Apellido, @context.Nombre</MudTd>
            <MudTd DataLabel="Materia">@(context.SiglaMateria ?? context.CodigoMateria)</MudTd>
            <MudTd DataLabel="Condición">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@context.CondicionActual</MudChip>
            </MudTd>
            <MudTd DataLabel="1° Parc.">
                <MudNumericField T="decimal?" @ref="_refsNotas[context.Indice][0]" @bind-Value="context.TpEva"
                                 Min="0" Max="99" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 0))" />
            </MudTd>
            <MudTd DataLabel="2° Parc.">
                <MudNumericField T="decimal?" @ref="_refsNotas[context.Indice][1]" @bind-Value="context.TpEva2"
                                 Min="0" Max="99" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 1))" />
            </MudTd>
            <MudTd DataLabel="Recup.">
                <MudNumericField T="decimal?" @ref="_refsNotas[context.Indice][2]" @bind-Value="context.Recuperatorio"
                                 Min="0" Max="99" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 2))" />
            </MudTd>
            <MudTd DataLabel="Hs." Class="d-none d-lg-table-cell">
                <MudNumericField T="int?" @ref="_refsEnteros[context.Indice][0]" @bind-Value="context.TotalHoras"
                                 Min="0" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 3))" />
            </MudTd>
            <MudTd DataLabel="Inasist." Class="d-none d-lg-table-cell">
                <MudNumericField T="int?" @ref="_refsEnteros[context.Indice][1]" @bind-Value="context.Inasistencias"
                                 Min="0" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 4))" />
            </MudTd>
            <MudTd DataLabel="Justif." Class="d-none d-lg-table-cell">
                <MudNumericField T="int?" @ref="_refsEnteros[context.Indice][2]" @bind-Value="context.Justificadas"
                                 Min="0" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                 Disabled="@context.ForzarLibre" OnKeyDown="@(e => SaltarSiEnter(e, context.Indice, 5))" />
            </MudTd>
            <MudTd DataLabel="Resultante">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ColorResultante(context)">
                    @Resultante(context)
                </MudChip>
            </MudTd>
            @if (PermiteLibre)
            {
                <MudTd DataLabel="Acciones">
                    @if (PuedePasarALibre(context))
                    {
                        <MudTooltip Text="@(context.ForzarLibre ? "Deshacer pase a Libre" : "Pasar a Libre")">
                            <MudIconButton Size="Size.Small"
                                           Icon="@(context.ForzarLibre ? Icons.Material.Filled.Undo : Icons.Material.Filled.Block)"
                                           Color="@(context.ForzarLibre ? Color.Default : Color.Error)"
                                           aria-label="Pasar la materia a Libre"
                                           OnClick="@(() => context.ForzarLibre = !context.ForzarLibre)" />
                        </MudTooltip>
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">No hay materias para regularizar.</MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_filas.Count > 0)
    {
        <div class="d-flex justify-end pa-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@_procesando" OnClick="Procesar">Procesar regularización</MudButton>
        </div>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter, EditorRequired] public string CodigoCarrera { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<RegularizacionCursadaDto> Filas { get; set; } = [];

    /// <summary>Se invoca tras un procesamiento exitoso, para que el host recargue.</summary>
    [Parameter] public EventCallback OnConfirmado { get; set; }

    /// <summary>Habilita el pase manual a Libre por materia (BtnLibre legacy: solo en la variante por-alumno).</summary>
    [Parameter] public bool PermiteLibre { get; set; }

    private readonly List<FilaVm> _filas = [];
    private decimal _notaPromocion;
    private bool _procesando;

    // Refs de los casilleros para el salto con Enter: [fila][0..2] son las notas
    // (1° Parc., 2° Parc., Recup.) y [fila][0..2] de enteros son Hs./Inasist./Justif.
    private MudNumericField<decimal?>?[][] _refsNotas = [];
    private MudNumericField<int?>?[][] _refsEnteros = [];

    protected override async Task OnParametersSetAsync()
    {
        _notaPromocion = await Confirmar.ObtenerNotaPromocionAsync(CancellationToken.None);
        _filas.Clear();
        _filas.AddRange(Filas.Select(FilaVm.Desde));
        for (var i = 0; i < _filas.Count; i++)
        {
            _filas[i].Indice = i;
        }

        _refsNotas = [.. Enumerable.Range(0, _filas.Count).Select(_ => new MudNumericField<decimal?>?[3])];
        _refsEnteros = [.. Enumerable.Range(0, _filas.Count).Select(_ => new MudNumericField<int?>?[3])];
    }

    /// <summary>
    /// Enter avanza al casillero siguiente en el orden de carga (1° Parc. → 2° Parc.
    /// → Recup. → Hs. → Inasist. → Justif.) y de la última columna pasa al primer
    /// casillero de la fila siguiente, repitiendo las horas si aún no tiene.
    /// </summary>
    private async Task SaltarSiEnter(KeyboardEventArgs e, int fila, int columna)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        var (f, c) = columna == 5 ? (fila + 1, 0) : (fila, columna + 1);
        while (f < _filas.Count && _filas[f].ForzarLibre)
        {
            f++;
        }

        if (f >= _filas.Count)
        {
            return;
        }

        // Las horas de la comisión se repiten de un registro al siguiente.
        if (f != fila && _filas[f].TotalHoras is null or 0 && _filas[fila].TotalHoras is > 0)
        {
            _filas[f].TotalHoras = _filas[fila].TotalHoras;
        }

        await EnfocarAsync(f, c);
    }

    private async Task EnfocarAsync(int fila, int columna)
    {
        if (columna <= 2)
        {
            if (_refsNotas[fila][columna] is { } nota)
            {
                await nota.FocusAsync();
                await nota.SelectAsync();
            }
        }
        else if (_refsEnteros[fila][columna - 3] is { } entero)
        {
            await entero.FocusAsync();
            await entero.SelectAsync();
        }
    }

    private static bool PuedePasarALibre(FilaVm f) =>
        f.CondicionActual is "CURSANDO" or "RECURSANDO";

    private CalculoResultado Calcular(FilaVm f) =>
        ConfirmarRegularizacionHandler.Resolver(f.AInput(), _notaPromocion) is var r
            ? new CalculoResultado(r.Condicion, r.VaAlAnalitico)
            : default;

    private string Resultante(FilaVm f)
    {
        if (f.ForzarLibre)
        {
            return "LIBRE (forzado)";
        }

        var r = Calcular(f);
        return r.VaAlAnalitico ? $"{r.Condicion} ✓" : r.Condicion;
    }

    private Color ColorResultante(FilaVm f)
    {
        if (f.ForzarLibre)
        {
            return Color.Error;
        }

        var r = Calcular(f);
        return r.Condicion switch
        {
            "REGULAR" or "PROMOCIONA" or "FINAL" => Color.Success,
            "RECURSA" or "LIBRE" => Color.Error,
            "REINCORPORA" => Color.Warning,
            _ => Color.Default,
        };
    }

    private async Task Procesar()
    {
        var codusu = (await EstadoAutenticacion!).User.CodigoUsuario();
        if (codusu is null)
        {
            Snackbar.Add("No se pudo determinar el usuario.", Severity.Error);
            return;
        }

        var confirma = await DialogService.ShowMessageBoxAsync(
            "Regularización",
            $"¿Procesar la regularización de {_filas.Count} materia(s)? Las que aprueben directo pasan al analítico y no se deshace.",
            yesText: "Procesar", cancelText: "Cancelar");
        if (confirma != true)
        {
            return;
        }

        _procesando = true;
        try
        {
            var command = new ConfirmarRegularizacionCommand
            {
                CodigoCarrera = CodigoCarrera,
                CodigoUsuario = codusu.Value,
                Filas = _filas.Select(f => f.AInput()).ToList(),
            };

            var resultado = await Confirmar.HandleAsync(command, CancellationToken.None);
            if (resultado.IsSuccess)
            {
                Snackbar.Add($"Se regularizaron {resultado.Value} materia(s).", Severity.Success);
                await OnConfirmado.InvokeAsync();
            }
            else
            {
                Snackbar.Add(resultado.Message ?? "No se pudo procesar la regularización.", Severity.Error);
            }
        }
        finally
        {
            _procesando = false;
        }
    }

    private readonly record struct CalculoResultado(string Condicion, bool VaAlAnalitico);

    private sealed class FilaVm
    {
        /// <summary>Posición en la grilla, para el salto con Enter entre casilleros.</summary>
        public int Indice { get; set; }

        public required string CodigoAlumno { get; init; }

        public string? Apellido { get; init; }

        public string? Nombre { get; init; }

        public required string CodigoMateria { get; init; }

        public string? SiglaMateria { get; init; }

        public required string CuatrimestreAnio { get; init; }

        public string? CondicionActual { get; init; }

        public bool MateriaPromociona { get; init; }

        public bool MateriaApruebaSinFinal { get; init; }

        public decimal? TpEva { get; set; }

        public decimal? TpEva2 { get; set; }

        public decimal? Recuperatorio { get; set; }

        public int? TotalHoras { get; set; }

        public int? Inasistencias { get; set; }

        public int? Justificadas { get; set; }

        /// <summary>Override manual "pasar a Libre".</summary>
        public bool ForzarLibre { get; set; }

        public NotaCursadoInput AInput() => new()
        {
            CodigoAlumno = CodigoAlumno,
            CodigoMateria = CodigoMateria,
            CuatrimestreAnio = CuatrimestreAnio,
            CondicionActual = CondicionActual,
            TpEva = TpEva,
            TpEva2 = TpEva2,
            Recuperatorio = Recuperatorio,
            TotalHoras = (short?)TotalHoras,
            Inasistencias = (short?)Inasistencias,
            Justificadas = (short?)Justificadas,
            MateriaPromociona = MateriaPromociona,
            MateriaApruebaSinFinal = MateriaApruebaSinFinal,
            ForzarLibre = ForzarLibre,
        };

        public static FilaVm Desde(RegularizacionCursadaDto d) => new()
        {
            CodigoAlumno = d.CodigoAlumno,
            Apellido = d.Apellido,
            Nombre = d.Nombre,
            CodigoMateria = d.CodigoMateria,
            SiglaMateria = d.SiglaMateria,
            CuatrimestreAnio = d.CuatrimestreAnio,
            CondicionActual = d.Condicion?.Trim() ?? string.Empty,
            MateriaPromociona = d.MateriaPromociona,
            MateriaApruebaSinFinal = d.MateriaApruebaSinFinal,
            TpEva = d.TpEva,
            TpEva2 = d.TpEva2,
            Recuperatorio = d.Recuperatorio,
            TotalHoras = d.TotalHoras,
            Inasistencias = d.Inasistencias,
            Justificadas = d.Justificadas,
        };
    }
}
