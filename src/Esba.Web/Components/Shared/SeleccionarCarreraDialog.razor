@using Esba.Application.Abstractions
@using Esba.Application.DTOs.Carreras
@inject ICarrerasQuery CarrerasQuery

@* Patrón canónico "elegir carrera al entrar a la opción" (decisión 2026-06-12,
   migration_improvements.md §3.2): solo las carreras permitidas al usuario. *@

<MudDialog>
    <DialogContent>
        <MudAutocomplete T="CarreraListItemDto" Label="Carrera" Variant="Variant.Outlined"
                         Value="_carreraSel" ValueChanged="SeleccionarCarrera"
                         SearchFunc="BuscarCarrera"
                         ToStringFunc="@(c => c is null ? string.Empty : (c.Nombre ?? c.Codigo))" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Disabled="@(_carrera is null)"
                   OnClick="@(() => MudDialog?.Close(DialogResult.Ok(_carrera)))">Continuar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private IReadOnlyList<CarreraListItemDto> _carreras = [];
    private CarreraListItemDto? _carreraSel;
    private string? _carrera;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var usuario = (await EstadoAutenticacion).User;
        var permisos = usuario.EsSupervisor() ? null : usuario.Permisos();
        _carreras = await CarrerasQuery.ListarParaMenuAsync(permisos, CancellationToken.None);
    }

    private void SeleccionarCarrera(CarreraListItemDto? carrera)
    {
        _carreraSel = carrera;
        _carrera = carrera?.Codigo;
    }

    private Task<IEnumerable<CarreraListItemDto>> BuscarCarrera(string? texto, CancellationToken ct)
    {
        IEnumerable<CarreraListItemDto> filtradas = string.IsNullOrWhiteSpace(texto)
            ? _carreras
            : _carreras.Where(c => CoincideCarrera(c, texto));
        return Task.FromResult(filtradas);
    }

    private static bool CoincideCarrera(CarreraListItemDto c, string texto) =>
        c.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase)
        || (c.Nombre?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
        || (c.NombreCorto?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false);
}
