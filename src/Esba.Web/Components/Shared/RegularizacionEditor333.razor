@using Esba.Application.DTOs.Academica
@using Esba.Application.Features.Academica
@using Esba.Domain.Academica
@using Esba.Web.Seguridad
@using Microsoft.AspNetCore.Components.Authorization
@inject ConfirmarRegularizacion333Handler Confirmar
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Grilla editable de regularización de secundario (333/650): régimen trimestral (3
   trimestres) + exámenes de diciembre/marzo, con acción "A previa". Solo markup, binding
   y estado de presentación; la condición la calcula el dominio (vía el handler) y el
   volcado el servidor (§2.1). Es ancha: scrollea en horizontal dentro de su panel. *@

<MudPaper Outlined="true" Class="pa-2">
    <div style="overflow-x:auto">
        <MudTable T="FilaVm" Items="_filas" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh Class="d-none d-md-table-cell">Alumno</MudTh>
                <MudTh>Materia</MudTh>
                <MudTh>Condición</MudTh>
                <MudTh>1°T</MudTh>
                <MudTh>2°T</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Fecha 2°T</MudTh>
                <MudTh>3°T</MudTh>
                <MudTh>Dic.</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Fecha Dic.</MudTh>
                <MudTh>Mar.</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Fecha Mar.</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Hs.</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Inasist.</MudTh>
                <MudTh>Resultante</MudTh>
                <MudTh aria-label="Acciones"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Alumno" Class="d-none d-md-table-cell">@context.Apellido, @context.Nombre</MudTd>
                <MudTd DataLabel="Materia">@(context.SiglaMateria ?? context.CodigoMateria)</MudTd>
                <MudTd DataLabel="Condición">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@context.CondicionActual</MudChip>
                </MudTd>
                <MudTd DataLabel="1°T">@Nota(context, f => f.TpEva, (f, v) => f.TpEva = v)</MudTd>
                <MudTd DataLabel="2°T">@Nota(context, f => f.TpEva2, (f, v) => f.TpEva2 = v)</MudTd>
                <MudTd DataLabel="Fecha 2°T" Class="d-none d-lg-table-cell">
                    <MudDatePicker @bind-Date="context.FecEva2" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="max-width:150px" Editable="true" Disabled="@context.ForzarPrevia" />
                </MudTd>
                <MudTd DataLabel="3°T">@Nota(context, f => f.TpEva3, (f, v) => f.TpEva3 = v)</MudTd>
                <MudTd DataLabel="Dic.">@Nota(context, f => f.NotaDic, (f, v) => f.NotaDic = v)</MudTd>
                <MudTd DataLabel="Fecha Dic." Class="d-none d-lg-table-cell">
                    <MudDatePicker @bind-Date="context.FechDic" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="max-width:150px" Editable="true" Disabled="@context.ForzarPrevia" />
                </MudTd>
                <MudTd DataLabel="Mar.">@Nota(context, f => f.NotaMar, (f, v) => f.NotaMar = v)</MudTd>
                <MudTd DataLabel="Fecha Mar." Class="d-none d-lg-table-cell">
                    <MudDatePicker @bind-Date="context.FechMar" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="max-width:150px" Editable="true" Disabled="@context.ForzarPrevia" />
                </MudTd>
                <MudTd DataLabel="Hs." Class="d-none d-lg-table-cell">
                    <MudNumericField T="int?" @bind-Value="context.TotalHoras" Min="0" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                     Disabled="@context.ForzarPrevia" />
                </MudTd>
                <MudTd DataLabel="Inasist." Class="d-none d-lg-table-cell">
                    <MudNumericField T="int?" @bind-Value="context.Inasistencias" Min="0" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Style="max-width:80px" Immediate="true" HideSpinButtons="true"
                                     Disabled="@context.ForzarPrevia" />
                </MudTd>
                <MudTd DataLabel="Resultante">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ColorResultante(context)">
                        @Resultante(context)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudTooltip Text="@(context.ForzarPrevia ? "Deshacer pase a Previa" : "Pasar a Previa")">
                        <MudIconButton Size="Size.Small"
                                       Icon="@(context.ForzarPrevia ? Icons.Material.Filled.Undo : Icons.Material.Filled.EventBusy)"
                                       Color="@(context.ForzarPrevia ? Color.Default : Color.Warning)"
                                       aria-label="Pasar la materia a Previa"
                                       OnClick="@(() => context.ForzarPrevia = !context.ForzarPrevia)" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No hay materias para regularizar.</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>

    @if (_filas.Count > 0)
    {
        <div class="d-flex align-center justify-end gap-4 pa-2">
            @if (HayFaltaFecha)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">
                    Cargá la fecha del examen de diciembre/marzo que aprueba antes de procesar.
                </MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(_procesando || HayFaltaFecha)" OnClick="Procesar">Procesar regularización</MudButton>
        </div>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter, EditorRequired] public string CodigoCarrera { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<Regularizacion333Dto> Filas { get; set; } = [];

    [Parameter] public EventCallback OnConfirmado { get; set; }

    private readonly List<FilaVm> _filas = [];
    private bool _procesando;

    private bool HayFaltaFecha => _filas.Any(f => !f.ForzarPrevia && Calcular(f).FaltaFecha);

    protected override void OnParametersSet()
    {
        _filas.Clear();
        _filas.AddRange(Filas.Select(FilaVm.Desde));
    }

    private RenderFragment Nota(FilaVm f, Func<FilaVm, decimal?> get, Action<FilaVm, decimal?> set) => builder =>
    {
        builder.OpenComponent<MudNumericField<decimal?>>(0);
        builder.AddAttribute(1, "Value", get(f));
        builder.AddAttribute(2, "ValueChanged", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<decimal?>(this, v => set(f, v)));
        builder.AddAttribute(3, "Min", (decimal?)0);
        builder.AddAttribute(4, "Max", (decimal?)99);
        builder.AddAttribute(5, "Variant", Variant.Outlined);
        builder.AddAttribute(6, "Margin", Margin.Dense);
        builder.AddAttribute(7, "Style", "max-width:70px");
        builder.AddAttribute(8, "Immediate", true);
        builder.AddAttribute(9, "HideSpinButtons", true);
        builder.AddAttribute(10, "Disabled", f.ForzarPrevia);
        builder.CloseComponent();
    };

    private CalculoCondicionRegularizacion333.Resultado Calcular(FilaVm f) =>
        ConfirmarRegularizacion333Handler.Resolver(f.AInput());

    private string Resultante(FilaVm f)
    {
        if (f.ForzarPrevia)
        {
            return "PREVIA (forzado)";
        }

        var r = Calcular(f);
        if (r.FaltaFecha)
        {
            return $"{r.Condicion} — falta fecha";
        }

        return r.VaAlAnalitico ? $"{r.Condicion} ✓ ({r.NotaFinal})" : r.Condicion;
    }

    private Color ColorResultante(FilaVm f)
    {
        if (f.ForzarPrevia)
        {
            return Color.Warning;
        }

        var r = Calcular(f);
        if (r.FaltaFecha)
        {
            return Color.Error;
        }

        return r.Condicion switch
        {
            "REGULAR" => Color.Success,
            "PREVIA" => Color.Warning,
            "ENPROCESO" => Color.Info,
            _ => Color.Default,
        };
    }

    private async Task Procesar()
    {
        var codusu = (await EstadoAutenticacion!).User.CodigoUsuario();
        if (codusu is null)
        {
            Snackbar.Add("No se pudo determinar el usuario.", Severity.Error);
            return;
        }

        var confirma = await DialogService.ShowMessageBoxAsync(
            "Regularización",
            $"¿Procesar la regularización de {_filas.Count} materia(s)? Las que queden REGULAR pasan al analítico y no se deshace.",
            yesText: "Procesar", cancelText: "Cancelar");
        if (confirma != true)
        {
            return;
        }

        _procesando = true;
        try
        {
            var command = new ConfirmarRegularizacion333Command
            {
                CodigoCarrera = CodigoCarrera,
                CodigoUsuario = codusu.Value,
                Filas = _filas.Select(f => f.AInput()).ToList(),
            };

            var resultado = await Confirmar.HandleAsync(command, CancellationToken.None);
            if (resultado.IsSuccess)
            {
                Snackbar.Add($"Se regularizaron {resultado.Value} materia(s).", Severity.Success);
                await OnConfirmado.InvokeAsync();
            }
            else
            {
                Snackbar.Add(resultado.Message ?? "No se pudo procesar la regularización.", Severity.Error);
            }
        }
        finally
        {
            _procesando = false;
        }
    }

    private sealed class FilaVm
    {
        public required string CodigoAlumno { get; init; }

        public string? Apellido { get; init; }

        public string? Nombre { get; init; }

        public required string CodigoMateria { get; init; }

        public string? SiglaMateria { get; init; }

        public required string CuatrimestreAnio { get; init; }

        public string? CondicionActual { get; init; }

        public decimal? TpEva { get; set; }

        public decimal? TpEva2 { get; set; }

        public decimal? TpEva3 { get; set; }

        public DateTime? FecEva1 { get; set; }

        public DateTime? FecEva2 { get; set; }

        public DateTime? FecEva3 { get; set; }

        public decimal? NotaDic { get; set; }

        public DateTime? FechDic { get; set; }

        public decimal? NotaMar { get; set; }

        public DateTime? FechMar { get; set; }

        public int? TotalHoras { get; set; }

        public int? Inasistencias { get; set; }

        public int? Justificadas { get; set; }

        public DateTime? Fecha { get; set; }

        public bool ForzarPrevia { get; set; }

        public NotaCursado333Input AInput() => new()
        {
            CodigoAlumno = CodigoAlumno,
            CodigoMateria = CodigoMateria,
            CuatrimestreAnio = CuatrimestreAnio,
            CondicionActual = CondicionActual,
            TpEva = TpEva,
            TpEva2 = TpEva2,
            TpEva3 = TpEva3,
            FecEva1 = FecEva1,
            FecEva2 = FecEva2,
            FecEva3 = FecEva3,
            NotaDic = NotaDic,
            FechDic = FechDic,
            NotaMar = NotaMar,
            FechMar = FechMar,
            TotalHoras = (short?)TotalHoras,
            Inasistencias = (short?)Inasistencias,
            Justificadas = (short?)Justificadas,
            Fecha = Fecha,
            ForzarPrevia = ForzarPrevia,
        };

        public static FilaVm Desde(Regularizacion333Dto d) => new()
        {
            CodigoAlumno = d.CodigoAlumno,
            Apellido = d.Apellido,
            Nombre = d.Nombre,
            CodigoMateria = d.CodigoMateria,
            SiglaMateria = d.SiglaMateria,
            CuatrimestreAnio = d.CuatrimestreAnio,
            CondicionActual = d.Condicion?.Trim() ?? string.Empty,
            TpEva = d.TpEva,
            TpEva2 = d.TpEva2,
            TpEva3 = d.TpEva3,
            FecEva1 = d.FecEva1,
            FecEva2 = d.FecEva2,
            FecEva3 = d.FecEva3,
            NotaDic = d.NotaDic,
            FechDic = d.FechDic,
            NotaMar = d.NotaMar,
            FechMar = d.FechMar,
            TotalHoras = d.TotalHoras,
            Inasistencias = d.Inasistencias,
            Justificadas = d.Justificadas,
            Fecha = d.Fecha ?? DateTime.Today,
        };
    }
}
