@* Menú general por área funcional (espejo de Application/Features), sucesor
   del "Main Menu" dxBar de FrmEsba. El diseño por carrera fue descartado en el
   propio legacy: con muchas carreras era molesto buscarlas una por una. La
   carrera se elige al entrar a cada opción que la necesite (decisión
   2026-06-12, ver migration_improvements.md §3.2).
   Las opciones se habilitan a medida que se migran sus pantallas. *@

<MudNavMenu Rounded="true" Color="Color.Primary" Margin="Margin.Dense" Class="pa-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Search">Búsqueda de alumnos</MudNavLink>

    <MudDivider Class="my-2" />

    @* Inscripción de materias y permisos de examen no van acá: son flujos por
       alumno, accesibles desde las acciones del buscador (/alumnos/{carre}/{cod}/…). *@
    <MudNavGroup Title="Alumnos" Icon="@Icons.Material.Filled.People" Expanded="false">
        <MudNavLink Href="/academica/regularizacion-comision" Icon="@Icons.Material.Filled.FactCheck">Regularización</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Académica" Icon="@Icons.Material.Filled.MenuBook" Expanded="false">
        <MudNavLink Href="/academica/materias" Icon="@Icons.Material.Filled.MenuBook">Materias</MudNavLink>
        <MudNavLink Href="/academica/comisiones" Icon="@Icons.Material.Filled.Groups">Comisiones</MudNavLink>
        <MudNavLink Href="/correo-comision" Icon="@Icons.Material.Filled.Email">Correo por comisión</MudNavLink>
        <MudNavLink Href="/academica/cuatrimestres" Icon="@Icons.Material.Filled.DateRange">Cuatrimestres</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Asistencias" Icon="@Icons.Material.Filled.EventAvailable" Expanded="false">
        <MudNavLink Href="/asistencias/carga" Icon="@Icons.Material.Filled.EditCalendar">Carga de inasistencias</MudNavLink>
        <MudNavLink Href="/asistencias/planillas" Icon="@Icons.Material.Filled.Summarize">Planillas de asistencia</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Exámenes" Icon="@Icons.Material.Filled.Grading" Expanded="false">
        <MudNavLink Href="/examenes/mesas" Icon="@Icons.Material.Filled.Grading">Mesas de exámenes</MudNavLink>
        <MudNavLink Href="/examenes/permisos-masivo" Icon="@Icons.Material.Filled.AssignmentTurnedIn">Permisos (carga masiva)</MudNavLink>
        <MudNavLink Href="/examenes/notas-finales" Icon="@Icons.Material.Filled.Grading">Notas de finales</MudNavLink>
        <MudNavLink Href="/examenes/actas/mesa" Icon="@Icons.Material.Filled.Print">Actas volantes (mesa)</MudNavLink>
        <MudNavLink Href="/examenes/actas/comision" Icon="@Icons.Material.Filled.Print">Actas por comisión</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Certificados" Icon="@Icons.Material.Filled.Description" Expanded="false">
        <MudNavLink Disabled="true">Constancias</MudNavLink>
        <MudNavLink Disabled="true">Equivalencias</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.Settings" Expanded="false">
        <MudNavLink Href="/administracion/usuarios" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios</MudNavLink>
        <MudNavLink Href="/administracion/profesores" Icon="@Icons.Material.Filled.CoPresent">Profesores</MudNavLink>
        <MudNavLink Href="/administracion/configuracion" Icon="@Icons.Material.Filled.Tune">Configuración</MudNavLink>
    </MudNavGroup>
</MudNavMenu>
