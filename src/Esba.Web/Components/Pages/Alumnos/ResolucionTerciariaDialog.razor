@* Pide los cuatrimestres a imprimir en la resolución de equivalencia terciaria
   (sucesor del InputBox de BtnImprimirFormatoNuevoClick). Solo recoge el dato; el
   PDF lo genera el endpoint. *@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
            Ingrese uno o más cuatrimestres separados por comas (por ejemplo: 2,3).
        </MudText>
        <MudTextField @bind-Value="_cuatrimestres" Label="Cuatrimestres a imprimir" Required="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_cuatrimestres)"
                   OnClick="Confirmar">Generar resolución</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    private string? _cuatrimestres;

    private void Confirmar()
    {
        if (string.IsNullOrWhiteSpace(_cuatrimestres))
        {
            return;
        }

        MudDialog?.Close(DialogResult.Ok(_cuatrimestres.Trim()));
    }
}
