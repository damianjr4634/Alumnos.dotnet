@using Esba.Application.Abstractions
@using Esba.Application.DTOs.Alumnos
@using Esba.Application.DTOs.Carreras
@using Esba.Application.Features.Alumnos
@using Esba.Domain.Common
@using Esba.Web.Seguridad
@using Microsoft.AspNetCore.Components.Authorization
@inject CambiarCarreraAlumnoHandler Handler
@inject ICarrerasQuery CarrerasQuery
@inject ISnackbar Snackbar

@* Sucesor de "Copiar alumno a la carrera…" / "Mover alumno a la carrera…" de FrmEsba
   (dxBarButton29/30Click): se elige la carrera destino entre las permitidas al usuario
   y el SP responde con la confirmación (FERRCOD=1) o el error (FERRCOD=2). Dos fases:
   previsualizar → mostrar el mensaje → confirmar. Solo markup, binding y llamadas al
   handler (§2.1). *@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            @Alumno.Apellido, @Alumno.Nombre — @Alumno.Codigo · carrera actual: @Alumno.CodigoCarrera
        </MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        @if (_confirmacion is null)
        {
            <MudAutocomplete T="CarreraListItemDto" Label="Carrera de destino" Variant="Variant.Outlined"
                             Value="_carreraSel" ValueChanged="@(c => _carreraSel = c)"
                             SearchFunc="BuscarCarrera"
                             ToStringFunc="@(c => c is null ? string.Empty : $"{c.Codigo} — {c.Nombre}")" />
            @if (Mover)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    Solo se puede mover un alumno sin materias cursadas ni analítico en la carrera actual.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    La copia conserva los datos personales y de estudios; el libro matriz queda en blanco en la carrera nueva.
                </MudText>
            }
        }
        else
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">@_confirmacion</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Cancel())">Cancelar</MudButton>
        @if (_confirmacion is null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_carreraSel is null || _procesando)" OnClick="Previsualizar">
                @(Mover ? "Mover" : "Copiar")
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_procesando" OnClick="Confirmar">Confirmar</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter] public AlumnoListItemDto Alumno { get; set; } = default!;

    /// <summary>true: mover (XXX_MUEVE_ALUMNO); false: copiar (XXX_COPIA_ALUMNO).</summary>
    [Parameter] public bool Mover { get; set; }

    private IReadOnlyList<CarreraListItemDto> _carreras = [];
    private CarreraListItemDto? _carreraSel;
    private string? _confirmacion;
    private string? _error;
    private bool _procesando;
    private int _codigoUsuario;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion!).User;
        _codigoUsuario = usuario.CodigoUsuario() ?? 0;
        var permitidos = usuario.EsSupervisor() ? null : usuario.Permisos();
        // Como el combo legacy (YYY_CARRE_SEGU): solo las carreras del usuario, sin la de origen.
        _carreras = (await CarrerasQuery.ListarParaMenuAsync(permitidos, CancellationToken.None))
            .Where(c => !string.Equals(c.Codigo, Alumno.CodigoCarrera, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private Task<IEnumerable<CarreraListItemDto>> BuscarCarrera(string? texto, CancellationToken ct)
    {
        IEnumerable<CarreraListItemDto> filtradas = string.IsNullOrWhiteSpace(texto)
            ? _carreras
            : _carreras.Where(c =>
                c.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || (c.Nombre?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.NombreCorto?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));
        return Task.FromResult(filtradas);
    }

    private CambiarCarreraAlumnoCommand Comando() => new()
    {
        CodigoAlumno = Alumno.Codigo,
        CodigoCarreraOrigen = Alumno.CodigoCarrera,
        CodigoCarreraDestino = _carreraSel?.Codigo ?? string.Empty,
        CodigoUsuario = _codigoUsuario,
    };

    private async Task Previsualizar()
    {
        _error = null;
        _procesando = true;
        try
        {
            var resultado = Mover
                ? await Handler.PrevisualizarMovimientoAsync(Comando(), CancellationToken.None)
                : await Handler.PrevisualizarCopiaAsync(Comando(), CancellationToken.None);
            Resolver(resultado);
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task Confirmar()
    {
        _error = null;
        _procesando = true;
        try
        {
            var resultado = Mover
                ? await Handler.ConfirmarMovimientoAsync(Comando(), CancellationToken.None)
                : await Handler.ConfirmarCopiaAsync(Comando(), CancellationToken.None);
            Resolver(resultado);
        }
        finally
        {
            _procesando = false;
        }
    }

    /// <summary>Semántica Result (§1.3): Ok/Warning → cierra con éxito; NeedsConfirmation → pide confirmar; Error → en el diálogo.</summary>
    private void Resolver(Result<string> resultado)
    {
        switch (resultado.Status)
        {
            case OperationStatus.Ok:
            case OperationStatus.Warning:
                Snackbar.Add(resultado.Value ?? resultado.Message ?? "Operación realizada.",
                    resultado.Status == OperationStatus.Warning ? MudBlazor.Severity.Warning : MudBlazor.Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
                break;
            case OperationStatus.NeedsConfirmation:
                _confirmacion = resultado.Message;
                break;
            default:
                _confirmacion = null;
                _error = resultado.Message;
                break;
        }
    }
}
