@using Esba.Application.Abstractions
@using Esba.Application.DTOs.Alumnos
@using Esba.Domain.Certificados
@using Esba.Domain.Enums
@using Esba.Web.Seguridad
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navegacion
@inject IDialogService DialogService
@inject ICarrerasQuery CarrerasQuery
@inject IJSRuntime JS

@* Sucesor del panel ALUMNO SELECCIONADO de FrmEsba: las acciones sobre el alumno
   elegido en el buscador. Antes vivía debajo de la grilla; ahora es modal para
   evitar el scroll al pie. Se habilitan a medida que se migran sus pantallas. *@

<MudDialog>
    <DialogContent>
        <div class="d-flex align-center flex-wrap gap-4 mb-2">
            <MudAvatar Color="Color.Primary" Size="Size.Large">
                @($"{Alumno.Apellido?.FirstOrDefault()}{Alumno.Nombre?.FirstOrDefault()}")
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6">@Alumno.Apellido, @Alumno.Nombre</MudText>
                <div class="d-flex align-center flex-wrap gap-2 mt-1">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@ColorEstado(Alumno)">@TextoEstado(Alumno)</MudChip>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Alumno.Codigo — @Alumno.NombreCarrera (@Alumno.Modalidad)
                    </MudText>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column gap-2">
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.Badge" OnClick="AbrirFicha">Ficha</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.MenuBook" OnClick="AbrirCursada">Inscripción de materias</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" OnClick="AbrirPermisos">Permisos de examen</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.FactCheck" OnClick="AbrirRegularizacion">Regularización</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.Grading" OnClick="AbrirNotasFinales">Notas de finales</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.Description" OnClick="AbrirConstancias">Constancias</MudButton>
            @* Impresión de las equivalencias cargadas: resolución (formato nuevo de
               lst_impresion_equivalencia_terc.pas) para terciarias, equivalencia bachiller
               para BAC. El servidor revalida el tipo de carrera. *@
            @if (_esTerciaria)
            {
                <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                           StartIcon="@Icons.Material.Filled.Gavel" OnClick="ImprimirResolucionTerciaria">Imprimir resolución de equivalencia</MudButton>
            }
            else if (_esBachiller)
            {
                <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                           StartIcon="@Icons.Material.Filled.Print" OnClick="ImprimirEquivalenciaBachiller">Imprimir equivalencia</MudButton>
            }
        </div>

        @* Sucesores de "Copiar/Mover alumno a la carrera…" y "Borrar alumno" del menú
           Alumno de FrmEsba. Borrar solo para supervisores: la UI lo oculta y el
           handler lo deniega con el claim (§2.7). *@
        <MudDivider Class="my-3" />
        <div class="d-flex flex-column gap-2">
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CambiarCarrera(mover: false))">Copiar a otra carrera</MudButton>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-start"
                       StartIcon="@Icons.Material.Filled.DriveFileMove" OnClick="@(() => CambiarCarrera(mover: true))">Mover a otra carrera</MudButton>
            @if (_esSupervisor)
            {
                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error" Class="justify-start"
                           StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="Borrar">Borrar alumno</MudButton>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Cancel())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter] public AlumnoListItemDto Alumno { get; set; } = default!;

    private bool _esSupervisor;
    private bool _esTerciaria;
    private bool _esBachiller;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            _esSupervisor = (await EstadoAutenticacion).User.EsSupervisor();
        }

        var tipoCarrera = await CarrerasQuery.ObtenerTipoAsync(Alumno.CodigoCarrera, CancellationToken.None);
        _esTerciaria = string.Equals(tipoCarrera?.Trim(), "TER", StringComparison.OrdinalIgnoreCase);
        _esBachiller = EquivalenciaBachillerFormatter.EsTipoBachiller(tipoCarrera);
    }

    /// <summary>Sucesor de BtnImprimirFormatoNuevoClick: pide los cuatrimestres y abre el PDF de la resolución.</summary>
    private async Task ImprimirResolucionTerciaria()
    {
        var dialogo = await DialogService.ShowAsync<ResolucionTerciariaDialog>("Imprimir resolución de equivalencia");
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: string cuatrimestres } && !string.IsNullOrWhiteSpace(cuatrimestres))
        {
            var url = $"/constancias/alumno/equivalencia-terciaria?carre={Uri.EscapeDataString(Alumno.CodigoCarrera)}" +
                      $"&cod={Uri.EscapeDataString(Alumno.Codigo)}&cuatrimestres={Uri.EscapeDataString(cuatrimestres)}";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
    }

    private async Task ImprimirEquivalenciaBachiller()
    {
        var url = $"/constancias/alumno/equivalencia-bachiller?carre={Uri.EscapeDataString(Alumno.CodigoCarrera)}" +
                  $"&cod={Uri.EscapeDataString(Alumno.Codigo)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task CambiarCarrera(bool mover)
    {
        var parametros = new DialogParameters<CambiarCarreraAlumnoDialog>
        {
            { x => x.Alumno, Alumno },
            { x => x.Mover, mover },
        };
        var dialogo = await DialogService.ShowAsync<CambiarCarreraAlumnoDialog>(
            mover ? "Mover alumno a la carrera…" : "Copiar alumno a la carrera…", parametros);
        await CerrarSiCambio(dialogo);
    }

    private async Task Borrar()
    {
        var parametros = new DialogParameters<BorrarAlumnoDialog> { { x => x.Alumno, Alumno } };
        var dialogo = await DialogService.ShowAsync<BorrarAlumnoDialog>("Borrar alumno", parametros);
        await CerrarSiCambio(dialogo);
    }

    /// <summary>Si la acción modificó el padrón, cierra este diálogo con true para que el buscador recargue.</summary>
    private async Task CerrarSiCambio(IDialogReference dialogo)
    {
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: true })
        {
            MudDialog?.Close(DialogResult.Ok(true));
        }
    }

    private void AbrirFicha() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/ficha");

    private void AbrirCursada() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/cursada");

    private void AbrirPermisos() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/permisos");

    private void AbrirRegularizacion() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/regularizacion");

    private void AbrirNotasFinales() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/notas-finales");

    private void AbrirConstancias() =>
        Ir($"/alumnos/{Alumno.CodigoCarrera}/{Alumno.Codigo}/constancia");

    private void Ir(string url)
    {
        MudDialog?.Close();
        Navegacion.NavigateTo(url);
    }

    private static string TextoEstado(AlumnoListItemDto alumno) => alumno switch
    {
        { Baja: true } => "Baja",
        { Estado: { } estado } => FichaAlumnoModel.Etiqueta(estado),
        _ => "Sin estado",
    };

    private static Color ColorEstado(AlumnoListItemDto alumno) => alumno switch
    {
        { Baja: true } => Color.Error,
        { Estado: EstadoAlumno.Cursando } => Color.Success,
        { Estado: EstadoAlumno.Egresado } => Color.Info,
        { Estado: EstadoAlumno.Pase } => Color.Warning,
        _ => Color.Default,
    };
}
