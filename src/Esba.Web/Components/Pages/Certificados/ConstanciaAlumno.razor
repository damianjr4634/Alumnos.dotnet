@page "/alumnos/{Carre}/{Codigo}/constancia"
@using Esba.Application.Abstractions
@using Esba.Application.DTOs.Alumnos
@using Esba.Application.DTOs.Certificados
@using Esba.Application.Features.Certificados
@using Esba.Domain.Certificados
@using Esba.Domain.Enums
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IAlumnosQuery AlumnosQuery
@inject GenerarConstanciaAlumnoHandler ConstanciaHandler
@inject GenerarConstanciaRegularHandler ConstanciaRegularHandler
@inject ObtenerAnaliticoAlumnoHandler AnaliticoHandler
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>ESBA — Constancia del Alumno</PageTitle>

@* Sucesora de constanciaalumnos2.pas: grilla del analítico (materias + promedio)
   y variantes de texto (CTT/Pase/Analítico). Solo binding y llamadas a Application
   (§2.1); el PDF lo sirve el endpoint /constancias/alumno y lo previsualiza el
   navegador (§3.3). *@

@if (_noEncontrado)
{
    <MudAlert Severity="MudBlazor.Severity.Warning">El alumno no existe.</MudAlert>
}
else if (_alumno is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <div class="d-flex align-center flex-wrap gap-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Href="@($"/alumnos/{Carre}/{Codigo}/cursada")" aria-label="Volver a la cursada" />
            <div>
                <MudText Typo="Typo.h5">@_alumno.Apellido, @_alumno.Nombre</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Constancia del alumno — Carrera @Carre — @Codigo
                </MudText>
            </div>
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4">
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Tipo de constancia</MudText>
                    <MudRadioGroup T="TipoConstancia" @bind-Value="_tipo">
                        <MudRadio T="TipoConstancia" Value="@TipoConstancia.CertificadoEnTramite" Dense="true">
                            Certificado de estudios en trámite
                        </MudRadio>
                        <MudRadio T="TipoConstancia" Value="@TipoConstancia.Pase" Dense="true">
                            Pase en trámite
                        </MudRadio>
                        <MudRadio T="TipoConstancia" Value="@TipoConstancia.Analitico" Dense="true">
                            Certificado analítico en trámite
                        </MudRadio>
                    </MudRadioGroup>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_anteQuien" Label="Para ser presentado ante"
                                  MaxLength="150" Required="true" Immediate="true"
                                  RequiredError="Indique ante quién se presenta la constancia." />
                    <MudCheckBox @bind-Value="_incluirMembrete" Color="Color.Primary" Class="mt-3"
                                 Label="Incluir membrete institucional" />
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-end gap-2 flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Email"
                               OnClick="EnviarRegularPorMail" Disabled="@_generando">
                        Constancia regular por mail
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.HowToReg"
                               OnClick="GenerarRegular" Disabled="@_generando">
                        Constancia de alumno regular
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="Generar" Disabled="@_generando">
                        @if (_generando)
                        {
                            <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                            <span>Generando…</span>
                        }
                        else
                        {
                            <span>Generar constancia</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <div class="d-flex align-center flex-wrap gap-4 mb-3">
            <MudText Typo="Typo.h6">Analítico — materias</MudText>
            <MudSpacer />
            <MudChip T="string" Variant="Variant.Text" Color="Color.Primary"
                     Icon="@Icons.Material.Filled.Functions">
                Promedio general: @_analitico.PromedioGeneral.ToString("0.00")
            </MudChip>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.TableChart"
                       OnClick="GenerarMateriasAprobadas" Disabled="@_generando">
                Constancia de materias aprobadas
            </MudButton>
        </div>

        <MudTable T="ConstanciaMateriaDto" Items="@_analitico.Materias" Dense="true" Hover="true" Striped="true"
                  Elevation="0" GroupBy="@_agrupacionPorCuatrimestre">
            <HeaderContent>
                <MudTh>Materia</MudTh>
                <MudTh>Condición</MudTh>
                <MudTh Class="d-none d-md-table-cell">Nota</MudTh>
                <MudTh Class="d-none d-md-table-cell">Fecha</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Instituto</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group" colspan="6">
                    @TextoCastellano.CuatrimestreEnLetras(Convert.ToInt32(context.Key)) Cuatrimestre
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Materia">
                    @context.CodigoMateria — @context.Descripcion
                    @if (context.Anual == "*")
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="Color.Default" Class="ml-2">anual</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Condición">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@CondicionMateriaColor.Para(context.Condicion)">@context.Condicion</MudChip>
                </MudTd>
                <MudTd DataLabel="Nota" Class="d-none d-md-table-cell">@FormatearNota(context.Nota)</MudTd>
                <MudTd DataLabel="Fecha" Class="d-none d-md-table-cell">
                    @(context.Fecha is { } f ? f.ToString("dd/MM/yyyy") : "—")
                </MudTd>
                <MudTd DataLabel="Instituto" Class="d-none d-lg-table-cell">@context.Instituto</MudTd>
                <MudTd>
                    @if (ConstanciaExamenFinal.EsCondicionElegible(context.Condicion))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Small"
                                       Color="Color.Primary" Disabled="@_generando"
                                       OnClick="@(() => GenerarExamenFinal(context))"
                                       aria-label="Constancia de examen final de esta materia" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">El alumno no tiene materias en el plan de la carrera.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string Carre { get; set; } = string.Empty;

    [Parameter] public string Codigo { get; set; } = string.Empty;

    private MudForm? _form;
    private AlumnoDetailDto? _alumno;
    private AnaliticoAlumnoModel _analitico = new();
    private bool _noEncontrado;
    private bool _generando;

    private TipoConstancia _tipo = TipoConstancia.CertificadoEnTramite;
    private string _anteQuien = string.Empty;
    private bool _incluirMembrete = true;

    private readonly TableGroupDefinition<ConstanciaMateriaDto> _agrupacionPorCuatrimestre = new()
    {
        Selector = m => m.Cuatrimestre,
        Expandable = false,
    };

    protected override async Task OnParametersSetAsync()
    {
        _alumno = await AlumnosQuery.ObtenerDetalleAsync(Carre, Codigo, CancellationToken.None);
        _noEncontrado = _alumno is null;
        if (_alumno is null)
        {
            return;
        }

        _analitico = await AnaliticoHandler.ObtenerAsync(Codigo, Carre, CancellationToken.None);
    }

    private static string FormatearNota(decimal? nota) =>
        nota is { } n && n != 0 ? n.ToString("0.00") : "—";

    private async Task Generar()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _generando = true;
        try
        {
            var command = ArmarComando();
            var chequeo = await ConstanciaHandler.ValidarAsync(command, confirmado: false, CancellationToken.None);

            var confirmar = false;
            switch (chequeo.Status)
            {
                case Esba.Domain.Common.OperationStatus.Error:
                    Snackbar.Add(chequeo.Message ?? "No se puede emitir la constancia.", MudBlazor.Severity.Error);
                    return;

                case Esba.Domain.Common.OperationStatus.NeedsConfirmation:
                    var ok = await DialogService.ShowMessageBoxAsync(
                        "Constancia", chequeo.Message ?? "¿Desea continuar?",
                        yesText: "Continuar", cancelText: "Cancelar");
                    if (ok != true)
                    {
                        return;
                    }

                    confirmar = true;
                    break;

                case Esba.Domain.Common.OperationStatus.Warning:
                    Snackbar.Add(chequeo.Message ?? string.Empty, MudBlazor.Severity.Warning);
                    break;
            }

            await AbrirPdf(command, confirmar);
        }
        finally
        {
            _generando = false;
        }
    }

    private GenerarConstanciaCommand ArmarComando() => new()
    {
        CodigoCarrera = Carre,
        CodigoAlumno = Codigo,
        Tipo = _tipo,
        AnteQuien = _anteQuien,
        IncluirMembrete = _incluirMembrete,
    };

    // Constancia de Alumno Regular (hito 10.4a): exige "ante quién"; el servidor revalida
    // que el alumno esté cursando (si no, avisa y no abre el PDF, como el legacy).
    private async Task GenerarRegular()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _generando = true;
        try
        {
            var command = new GenerarConstanciaRegularCommand
            {
                CodigoCarrera = Carre,
                CodigoAlumno = Codigo,
                AnteQuien = _anteQuien,
                IncluirMembrete = _incluirMembrete,
            };

            var chequeo = await ConstanciaRegularHandler.ValidarAsync(command, CancellationToken.None);
            if (!chequeo.IsSuccess)
            {
                Snackbar.Add(chequeo.Message ?? "No se puede emitir la constancia.", MudBlazor.Severity.Error);
                return;
            }

            var url = $"/constancias/alumno/regular?carre={Uri.EscapeDataString(Carre)}" +
                      $"&cod={Uri.EscapeDataString(Codigo)}" +
                      $"&ante={Uri.EscapeDataString(_anteQuien)}" +
                      $"&membrete={_incluirMembrete.ToString().ToLowerInvariant()}";

            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        finally
        {
            _generando = false;
        }
    }

    // Enviar la constancia regular por mail al alumno (hito 10.4c). El servidor genera
    // el PDF, lo adjunta y lo manda al mail del alumno (sucesor de la opción "Mail" del legacy).
    private async Task EnviarRegularPorMail()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _generando = true;
        try
        {
            var command = new GenerarConstanciaRegularCommand
            {
                CodigoCarrera = Carre,
                CodigoAlumno = Codigo,
                AnteQuien = _anteQuien,
                IncluirMembrete = _incluirMembrete,
            };

            var resultado = await ConstanciaRegularHandler.EnviarPorMailAsync(command, CancellationToken.None);
            if (resultado.IsSuccess)
            {
                Snackbar.Add("Constancia enviada por mail al alumno.", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add(resultado.Message ?? "No se pudo enviar la constancia.", MudBlazor.Severity.Error);
            }
        }
        finally
        {
            _generando = false;
        }
    }

    // Constancia de Materias Aprobadas (reporte tabular del analítico, hito 9.2b).
    // No tiene chequeo de negocio (el legacy la emite directo); solo exige "ante quién".
    private async Task GenerarMateriasAprobadas()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _generando = true;
        try
        {
            var url = $"/constancias/alumno/materias-aprobadas?carre={Uri.EscapeDataString(Carre)}" +
                      $"&cod={Uri.EscapeDataString(Codigo)}" +
                      $"&ante={Uri.EscapeDataString(_anteQuien)}" +
                      $"&membrete={_incluirMembrete.ToString().ToLowerInvariant()}";

            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        finally
        {
            _generando = false;
        }
    }

    // Constancia de Examen Final (hito 9.2c): acción de fila sobre una materia rendida.
    // La elegibilidad por condición se re-valida en el servidor (autoritativo); acá solo
    // se muestra el botón cuando corresponde. Exige "ante quién".
    private async Task GenerarExamenFinal(ConstanciaMateriaDto materia)
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _generando = true;
        try
        {
            var url = $"/constancias/alumno/examen-final?carre={Uri.EscapeDataString(Carre)}" +
                      $"&cod={Uri.EscapeDataString(Codigo)}" +
                      $"&codmat={Uri.EscapeDataString(materia.CodigoMateria ?? string.Empty)}" +
                      $"&ante={Uri.EscapeDataString(_anteQuien)}" +
                      $"&membrete={_incluirMembrete.ToString().ToLowerInvariant()}";

            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        finally
        {
            _generando = false;
        }
    }

    private async Task AbrirPdf(GenerarConstanciaCommand command, bool confirmar)
    {
        var url = $"/constancias/alumno?carre={Uri.EscapeDataString(command.CodigoCarrera)}" +
                  $"&cod={Uri.EscapeDataString(command.CodigoAlumno)}" +
                  $"&tipo={command.Tipo}" +
                  $"&ante={Uri.EscapeDataString(command.AnteQuien ?? string.Empty)}" +
                  $"&conf={confirmar.ToString().ToLowerInvariant()}" +
                  $"&membrete={command.IncluirMembrete.ToString().ToLowerInvariant()}";

        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
