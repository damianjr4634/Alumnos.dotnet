@page "/"
@using Esba.Application.Abstractions
@using Esba.Application.DTOs.Alumnos
@using Esba.Domain.Enums
@using Esba.Web.Components.Pages.Alumnos
@using Esba.Web.Components.Shared
@using Esba.Web.State
@inject IAlumnosQuery AlumnosQuery
@inject IDialogService DialogService
@inject NavigationManager Navegacion
@inject EstadoBusquedaAlumnos Estado

<PageTitle>ESBA — Búsqueda de Alumnos</PageTitle>

@* Buscador global de alumnos sin importar carrera: el centro de la pantalla
   principal del legacy (FrmEsba). Misma semántica: "apellido" o
   "apellido:nombre"; el término también busca en mail y código de alumno. *@

<div class="d-flex align-center flex-wrap gap-2 mb-4">
    <div>
        <MudText Typo="Typo.h5">Búsqueda de alumnos</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Padrón general de todas las carreras
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="NuevoAlumno">Nuevo alumno</MudButton>
</div>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="6" md="5">
            <MudTextField T="string" @bind-Value="Estado.Texto" Label="Apellido[:Nombre], código o e-mail"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="BuscarSiEnter" autofocus />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       FullWidth="true" OnClick="Buscar">Buscar</MudButton>
        </MudItem>
        <MudItem xs="12" md="5" Class="d-flex align-center flex-wrap gap-4">
            <MudCheckBox T="bool" @bind-Value="Estado.BuscarBajas" Label="Buscar en bajas" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="Estado.CarrerasEnDesuso" Label="Incluir carreras en desuso" Dense="true" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Outlined="true" Class="overflow-hidden">
    <MudDataGrid T="AlumnoListItemDto" @ref="_grilla" ServerData="CargarPagina" Dense="true" Hover="true"
                 Striped="true" Elevation="0" RowClick="SeleccionarFila" RowsPerPage="25"
                 @bind-CurrentPage="Estado.Pagina" RowClassFunc="ClaseFila">
        <Columns>
            <PropertyColumn Property="a => a.NombreCarrera" Title="Carrera" />
            <PropertyColumn Property="a => a.Codigo" Title="Código" />
            <PropertyColumn Property="a => a.Matriz" Title="LM"
                            HeaderClass="d-none d-md-table-cell" CellClass="d-none d-md-table-cell" />
            <PropertyColumn Property="a => a.Apellido" Title="Apellido" />
            <PropertyColumn Property="a => a.Nombre" Title="Nombre" />
            <PropertyColumn Property="a => a.Mail" Title="E-Mail"
                            HeaderClass="d-none d-lg-table-cell" CellClass="d-none d-lg-table-cell" />
            <TemplateColumn Title="Modalidad" HeaderClass="d-none d-md-table-cell" CellClass="d-none d-md-table-cell">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Item.Modalidad</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@ColorEstado(context.Item)">@TextoEstado(context.Item)</MudChip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AlumnoListItemDto" RowsPerPageString="Filas por página:" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    private MudDataGrid<AlumnoListItemDto>? _grilla;

    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private async Task<GridData<AlumnoListItemDto>> CargarPagina(GridState<AlumnoListItemDto> estado, CancellationToken ct)
    {
        var usuario = (await EstadoAutenticacion!).User;

        var pagina = await AlumnosQuery.BuscarPadronAsync(
            new PadronAlumnosFiltro
            {
                Texto = Estado.Texto,
                BuscarDadosDeBaja = Estado.BuscarBajas,
                IncluirCarrerasEnDesuso = Estado.CarrerasEnDesuso,
                EsSupervisor = usuario.EsSupervisor(),
                CodigoUsuario = usuario.CodigoUsuario(),
                Skip = estado.Page * estado.PageSize,
                Take = estado.PageSize,
            },
            ct);

        return new GridData<AlumnoListItemDto> { Items = pagina.Items, TotalItems = pagina.Total };
    }

    private Task Buscar()
    {
        Estado.CodigoSeleccionado = null;
        Estado.CarreraSeleccionada = null;
        Estado.Pagina = 0;
        return _grilla?.ReloadServerData() ?? Task.CompletedTask;
    }

    private Task BuscarSiEnter(KeyboardEventArgs e) =>
        e.Key == "Enter" ? Buscar() : Task.CompletedTask;

    private async Task SeleccionarFila(DataGridRowClickEventArgs<AlumnoListItemDto> fila)
    {
        Estado.CodigoSeleccionado = fila.Item.Codigo;
        Estado.CarreraSeleccionada = fila.Item.CodigoCarrera;
        var parametros = new DialogParameters<AccionesAlumnoDialog> { { x => x.Alumno, fila.Item } };
        await DialogService.ShowAsync<AccionesAlumnoDialog>("Alumno seleccionado", parametros);
    }

    private string ClaseFila(AlumnoListItemDto alumno, int _) =>
        alumno.Codigo == Estado.CodigoSeleccionado && alumno.CodigoCarrera == Estado.CarreraSeleccionada
            ? "cursor-pointer esba-fila-seleccionada"
            : "cursor-pointer";

    private static string TextoEstado(AlumnoListItemDto alumno) => alumno switch
    {
        { Baja: true } => "Baja",
        { Estado: { } estado } => FichaAlumnoModel.Etiqueta(estado),
        _ => "Sin estado",
    };

    private static Color ColorEstado(AlumnoListItemDto alumno) => alumno switch
    {
        { Baja: true } => Color.Error,
        { Estado: EstadoAlumno.Cursando } => Color.Success,
        { Estado: EstadoAlumno.Egresado } => Color.Info,
        { Estado: EstadoAlumno.Pase } => Color.Warning,
        _ => Color.Default,
    };

    private async Task NuevoAlumno()
    {
        var dialogo = await DialogService.ShowAsync<SeleccionarCarreraDialog>("Alta de alumno — Carrera");
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: string carrera })
        {
            Navegacion.NavigateTo($"/alumnos/{carrera}/ficha/nueva");
        }
    }
}
