@using Esba.Application.DTOs.Administracion
@using Esba.Application.Features.Administracion
@inject BlanquearPasswordHandler BlanquearPassword
@inject ISnackbar Snackbar

@* Blanqueo de contraseña por un administrador: fija una clave temporal y obliga
   al usuario a cambiarla en el próximo login. Solo binding y llamadas a
   Application (§2.1). *@

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Asigná una contraseña temporal para @NombreUsuario. Deberá cambiarla en su próximo ingreso.
        </MudText>
        <MudTextField @bind-Value="_temporal" Label="Contraseña temporal" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_confirmacion" Label="Repetir contraseña temporal" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_guardando" OnClick="Guardar">
            Blanquear contraseña
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int CodigoUsuario { get; set; }

    [Parameter] public string NombreUsuario { get; set; } = string.Empty;

    private string _temporal = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _guardando;
    private string? _error;

    private async Task Guardar()
    {
        _error = null;
        if (_temporal != _confirmacion)
        {
            _error = "Las contraseñas no coinciden.";
            return;
        }

        _guardando = true;
        try
        {
            var resultado = await BlanquearPassword.HandleAsync(new BlanquearPasswordCommand
            {
                CodigoUsuario = CodigoUsuario,
                PasswordTemporal = _temporal,
            }, CancellationToken.None);

            if (resultado.IsSuccess)
            {
                Snackbar.Add("Contraseña blanqueada.", MudBlazor.Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                _error = resultado.Message;
            }
        }
        finally
        {
            _guardando = false;
        }
    }
}
