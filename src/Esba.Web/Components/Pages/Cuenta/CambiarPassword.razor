@page "/cambiar-password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Esba.Application.DTOs.Administracion
@using Esba.Application.Features.Administracion
@using Esba.Web.Seguridad
@inject CambiarPasswordHandler CambiarPasswordHandler
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion

<PageTitle>ESBA — Cambiar contraseña</PageTitle>

@* Cambio de contraseña por el propio usuario (sucesor de CambioPassword.pas).
   Solo binding y llamadas a Application (§2.1). *@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudPaper Outlined="true" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">Cambiar contraseña</MudText>

        @if (_forzado)
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-4">
                Tenés que cambiar tu contraseña antes de seguir usando el sistema.
            </MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_actual" Label="Contraseña actual" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_nueva" Label="Nueva contraseña" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_confirmacion" Label="Repetir nueva contraseña" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

        <div class="d-flex justify-end">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_guardando" OnClick="Guardar">
                Cambiar contraseña
            </MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private string _actual = string.Empty;
    private string _nueva = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _forzado;
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion!).User;
        _forzado = usuario.FindFirst(EsbaClaims.DebeCambiarPassword)?.Value == "S";
    }

    private async Task Guardar()
    {
        _guardando = true;
        _error = null;
        try
        {
            var usuario = (await EstadoAutenticacion!).User;
            var codigo = usuario.CodigoUsuario();
            if (codigo is null)
            {
                _error = "No se pudo identificar al usuario.";
                return;
            }

            var resultado = await CambiarPasswordHandler.HandleAsync(new CambiarPasswordCommand
            {
                CodigoUsuario = codigo.Value,
                PasswordActual = _actual,
                PasswordNueva = _nueva,
                PasswordNuevaConfirmacion = _confirmacion,
            }, CancellationToken.None);

            if (resultado.IsSuccess)
            {
                Snackbar.Add("Contraseña actualizada.", MudBlazor.Severity.Success);
                Navegacion.NavigateTo("/");
            }
            else
            {
                _error = resultado.Message;
            }
        }
        finally
        {
            _guardando = false;
        }
    }
}
